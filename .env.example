# ════════════════════════════════════════════════════════════════
# ENVIRONMENT VARIABLES - EventBot v5.0
# 
# INSTRUÇÕES:
# 1. Copie este arquivo para .env
# 2. Preencha com seus valores reais
# 3. NUNCA commite .env no Git
# ════════════════════════════════════════════════════════════════

# SUPABASE CONFIGURATION
# Acesse: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=seu_anon_key_aqui

# GOOGLE OAUTH (Optional)
GOOGLE_CLIENT_ID=seu_client_id_aqui
GOOGLE_API_KEY=sua_api_key_aqui
GOOGLE_CALENDAR_ID=seu_calendar_id_aqui

# OPENROUTER API (Optional - para IA)
OPENROUTER_KEY=sua_openrouter_key_aqui

# MODO DESENVOLVIMENTO
DEV_MODE=false
